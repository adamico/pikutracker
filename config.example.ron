// Example settings for pikutracker.
//
// pikutracker runs without this file, because its defaults are built in, and it never
// creates or changes this file. To rebind keys, copy it to:
//
//     $XDG_CONFIG_HOME/pikutracker/config.ron
//
// which is usually ~/.config/pikutracker/config.ron, then edit the copy.
(
    // The version of this file's format. Leave it as it is.
    version: 1,

    // The key preset: PcTracker (the default) or M8Style. In M8Style, Z is EDIT and X is
    // OPTION: Z with the arrows edits, Shift with the arrows changes the focused pane, and
    // X with a letter toggles a view.
    preset: PcTracker,

    // Only the keys you want to change. Anything not listed keeps the preset's key, so
    // later versions can add new default keys without losing your changes.
    //
    // A key is written in one of three ways:
    //
    //     "Ctrl+Shift+S"    a key pressed with Ctrl, Shift or Alt held
    //     "Z+X"             a hold-chord: hold Z, then press X
    //     "Double-tap Z"    the same key pressed twice quickly
    //
    // A key that starts a hold-chord acts when it is let go, unless the chord was played.
    // Other names include Up, Down, Left, Right, Tab, Space, Enter, Esc, Backspace,
    // Insert, Delete and F1 to F12. Further actions include MoveUp, FocusNext, Confirm,
    // Cancel, Clear, JumpUp (Alt+Up), SelectUp (Shift+Up), SelectJumpUp (Shift+Alt+Up),
    // StartSelection (no PcTracker key), Mute1 to Mute8, Solo1 to Solo8, NudgeUp (Ctrl+Up),
    // NudgeDownCoarse (Ctrl+Shift+Down), OctaveUp and ToggleSongLoopRow.
    //
    // Remove the // in front of a line to use it, then change the key. The keys shown
    // are the PcTracker preset's.
    keys: {
        // Project
        // "NewProject": "Ctrl+N",
        // "OpenProject": "Ctrl+O",
        // "Save": "Ctrl+S",
        // "SaveAs": "Ctrl+Shift+S",
        // "Import": "Ctrl+I",
        // "Export": "Ctrl+E",
        // "Quit": "Ctrl+Q",

        // Editing
        // "NewUnused": "Ctrl+Shift+N",
        // "Copy": "Ctrl+C",
        // "Cut": "Ctrl+X",
        // "Paste": "Ctrl+V",
        // "Clone": "Ctrl+D",
        // "DeepClone": "Ctrl+Shift+D",
        // "Undo": "Ctrl+Z",
        // "Redo": "Ctrl+Y",
        // "InsertRow": "Insert",
        // "DeleteRow": "Ctrl+Delete",
        // "MoveRowsUp": "Alt+Up",
        // "MoveRowsDown": "Alt+Down",
        // "ChangeSpeed": "Ctrl+Shift+T",
        // "ScaleSpeed": "Alt+T",
        // "PurgeUnused": "Ctrl+Shift+P",

        // Views
        // "ToggleCart": "Ctrl+T",
        // "ToggleLog": "Ctrl+L",

        // Playback
        // "PlayFocusedPane": "Space",
        // "PlaySongFromCursor": "Shift+Space",
        // "ClearMutesAndSolos": "F9",
        // "ToggleFollow": "F10",

        // MIDI Import dialog
        // "ResetMidiTable": "Shift+R",
    },
)
